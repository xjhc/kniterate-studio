{
  "name": "kniterate-studio",
  "private": true,
  "version": "1.0.0-rc.1",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm --dir apps/studio dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck",
    "kniterate:conform": "pnpm --dir packages/machine-lib kniterate:conform",
    "release:trial": "tsx scripts/build-v1-knit-trial.ts",
    "release:register": "tsx scripts/register-v1-knit-trial.ts",
    "release:physical-check": "pnpm --dir packages/machine-lib kniterate:swatches && tsx scripts/check-v1-physical-release.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm kniterate:conform && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "tsx": "^4.23.0"
  }
}
